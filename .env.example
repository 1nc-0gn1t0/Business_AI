# Local development only. Defaults also work without this file.
POSTGRES_DB=business_ai
POSTGRES_USER=business_ai
POSTGRES_PASSWORD=local-development-only
API_PORT=8000
WEB_PORT=5173
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
# Explicit opt-in only; also requires a separately imported synthetic dataset.
DATA_DEMO_ENABLED=false
## U-03: opt-in v2 agent; never grants acquisition permission.
BA_AGENT_ENABLED=0
BA_AGENT_LIMITS_JSON=
